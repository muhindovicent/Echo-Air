# Echo & Air Commerce Database Configuration
#
# Copy this file to `.env` and fill in the values provided by your database
# administrator. Never commit `.env` to version control — it contains secrets.

# Primary connection URL used by the application and Prisma Client.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://echoair:changeme@localhost:5432/echoair?schema=public"

# Direct connection URL used by Prisma Migrations (shadow database, pooling
# bypassed). Required for `prisma migrate` and `prisma db push`.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DIRECT_URL="postgresql://echoair:changeme@localhost:5432/echoair?schema=public"

# Optional test database URL for integration tests. If unset, integration
# tests that require a live PostgreSQL instance are skipped and reported.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
TEST_DATABASE_URL="postgresql://echoair:changeme@localhost:5432/echoair_test?schema=public"
